---
import { Image } from 'astro:assets';
import type { Photo } from '../lib/data';
import { imageByName } from '../lib/images';

interface Props { photos: Photo[]; layout?: 'mosaic' | 'all' }
const { photos, layout = 'mosaic' } = Astro.props;
---
<div class={`photos ${layout}`}>
  {photos.map((p, i) => (
    <figure class={layout === 'mosaic' ? `p${i + 1}` : undefined}>
      <Image src={imageByName(p.image)} alt={p.alt} widths={[400, 700, 1000]} sizes={layout === 'mosaic' && i === 0 ? '(max-width: 760px) 100vw, 700px' : '(max-width: 760px) 50vw, 360px'} />
      <figcaption>{p.caption} · {p.place}</figcaption>
    </figure>
  ))}
</div>
<style>
  .photos { display: grid; gap: 10px; }
  figure { margin: 0; position: relative; overflow: hidden; border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 18px 50px -26px var(--glow-card); background: var(--raise); }
  img { width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 12px 10px;
    font-size: 0.82rem; color: #fff; background: linear-gradient(transparent, rgba(5, 10, 18, 0.82));
  }
  .mosaic { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: 160px; }
  .p1 { grid-column: span 4; grid-row: span 2; }
  .p2 { grid-column: span 2; grid-row: span 3; }
  .p3, .p4 { grid-column: span 2; }
  .all { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); grid-auto-rows: 240px; }
  @media (prefers-reduced-motion: no-preference) {
    img { transition: transform 0.6s ease; }
    figure:hover img { transform: scale(1.03); }
  }
  @media (max-width: 760px) {
    .mosaic { grid-template-columns: 1fr 1fr; grid-auto-rows: 140px; }
    .p1 { grid-column: span 2; grid-row: span 2; }
    .p2 { grid-column: span 1; grid-row: span 2; }
    .p3, .p4 { grid-column: span 1; }
  }
</style>
