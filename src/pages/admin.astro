---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
const EDITOR = 'https://app.pagescms.org/';
---
<Base title="Editor" noindex>
  <meta slot="head" http-equiv="refresh" content={`3; url=${EDITOR}`} />
  <PageHead title="Opening the editor…" lede="Sign in with GitHub and pick hvdxx/hadiahmed.com to add or edit posts." />
  <p class="wrap"><a class="btn" href={EDITOR}>Open the editor</a></p>
</Base>
