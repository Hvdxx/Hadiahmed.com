---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { photos } from '../lib/data';
---
<Base title="Photos" description="Photos from around Houston: Hermann Park, the Japanese Garden, campus and friends.">
  <PageHead title="Photos" lede="Photography I shoot for myself, and a few moments with friends. Mostly Hermann Park, the Japanese Garden and campus." />
  <section class="wrap block glow" aria-label="All photos">
    <PhotoGrid photos={photos} layout="all" />
  </section>
</Base>
