---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TypeTag from './TypeTag.astro';
import TimeAgo from './TimeAgo.astro';
import { readingTime, type EntryLike } from '../lib/entries';
import { url } from '../lib/url';

interface Props { entry: EntryLike }
const { entry } = Astro.props;
const image = entry.data.image as ImageMetadata | undefined;
const minutes = readingTime(entry.body ?? '');
---
<section class="block wrap glow" aria-labelledby="latest-h">
  <h2 class="sec" id="latest-h">Latest</h2>
  <article class:list={['latest', { 'no-image': !image }]}>
    {image && (
      <Image src={image} alt={entry.data.imageAlt ?? ''} widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 100vw, 620px" class="pic" />
    )}
    <div class="txt">
      <TypeTag type={entry.data.type} />
      <h3><a href={url(`posts/${entry.id}`)}>{entry.data.title}</a></h3>
      {entry.data.summary && <p>{entry.data.summary}</p>}
      <div class="meta">
        <TimeAgo date={entry.data.date} />
        <span>{minutes} min read</span>
      </div>
    </div>
  </article>
</section>
<style>
  .latest {
    position: relative; display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    background: var(--panel); border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
    box-shadow: 0 30px 80px -30px var(--glow-card);
  }
  .latest.no-image { grid-template-columns: 1fr; }
  .pic { width: 100%; height: 100%; min-height: 300px; object-fit: cover; }
  .txt { padding: 28px; display: flex; flex-direction: column; gap: 10px; justify-content: center; }
  .no-image .txt { padding: 34px clamp(24px, 4vw, 44px); max-width: 760px; }
  h3 { margin: 0; font-size: clamp(1.35rem, 2.6vw, 1.8rem); line-height: 1.2; font-weight: 600; letter-spacing: -0.01em; }
  h3 a { text-decoration: none; }
  /* Whole card is clickable through the title link */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .latest:hover h3 a { text-decoration: underline; text-decoration-color: var(--t-writing); text-underline-offset: 5px; }
  .latest:focus-within { outline: 2px solid var(--t-project); outline-offset: 3px; }
  h3 a:focus-visible { outline: none; }
  p { margin: 0; color: var(--muted); }
  @media (max-width: 760px) {
    .latest { grid-template-columns: 1fr; }
    .pic { min-height: 0; aspect-ratio: 16 / 10; }
  }
</style>
