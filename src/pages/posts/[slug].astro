---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import TypeTag from '../../components/TypeTag.astro';
import TimeAgo from '../../components/TimeAgo.astro';
import { publishedEntries, readingTime } from '../../lib/entries';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const sorted = publishedEntries(await getCollection('posts'));
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: sorted[i - 1], older: sorted[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const image = entry.data.image as ImageMetadata | undefined;
---
<Base title={entry.data.title} description={entry.data.summary} image={image}>
  <article class="wrap post fade-in">
    <header>
      <TypeTag type={entry.data.type} />
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <TimeAgo date={entry.data.date} />
        <span>{readingTime(entry.body ?? '')} min read</span>
      </div>
    </header>
    {image && (
      <figure class="hero-img">
        <Image src={image} alt={entry.data.imageAlt ?? ''} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1080px) 100vw, 1040px" loading="eager" />
      </figure>
    )}
    <div class="prose"><Content /></div>
  </article>
  {(newer || older) && (
    <nav class="wrap pager" aria-label="More entries">
      {older ? <a href={url(`posts/${older.id}`)} class="older"><span>Older</span>{older.data.title}</a> : <span></span>}
      {newer && <a href={url(`posts/${newer.id}`)} class="newer"><span>Newer</span>{newer.data.title}</a>}
    </nav>
  )}
</Base>
<style>
  .post { padding-top: 26px; }
  header { display: flex; flex-direction: column; gap: 12px; max-width: 760px; margin-bottom: 26px; }
  h1 { margin: 0; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }
  .hero-img { margin: 0 0 32px; }
  .hero-img img { width: 100%; max-height: 620px; object-fit: cover; border-radius: 14px; border: 1px solid var(--line); box-shadow: 0 30px 80px -30px var(--glow-card); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); text-decoration: none; font-weight: 600; }
  .pager a:hover { border-color: var(--t-project); }
  .pager span { font: 500 0.72rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .newer { text-align: right; grid-column: 2; }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } .newer { grid-column: 1; text-align: left; } }
</style>
