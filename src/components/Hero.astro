---
import { Image } from 'astro:assets';
import { profile } from '../lib/data';
import { imageByName } from '../lib/images';
import { url } from '../lib/url';
const c = profile.contact;
---
<section class="hero wrap fade-in" aria-labelledby="hero-name">
  <Image
    src={imageByName('portrait.webp')}
    alt="Hadi Ahmed in a black suit and tie, arms crossed, against a gray studio backdrop"
    widths={[260, 400, 520]}
    sizes="(max-width: 760px) 240px, 260px"
    loading="eager"
    fetchpriority="high"
    class="portrait"
  />
  <div class="text">
    <h1 id="hero-name">{profile.name}</h1>
    <p class="intro">{profile.intro}</p>
    <ul class="chips" aria-label="Quick facts">
      <li class="chip"><span class="dot" aria-hidden="true"></span>{profile.status}</li>
      {profile.chips.map((chip) => <li class="chip">{chip}</li>)}
    </ul>
    <div class="links">
      <a class="btn" href={url('resume.pdf')}>Resume (PDF)</a>
      <a href={`mailto:${c.email}`}>Email</a>
      <a href={c.linkedin}>LinkedIn</a>
      <a href={c.instagram}>Instagram</a>
    </div>
  </div>
</section>
<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: clamp(22px, 4vw, 46px); align-items: center;
    padding-top: 28px; padding-bottom: 44px; border-bottom: 1px solid var(--line);
  }
  .portrait {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 18%;
    border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 24px 70px -24px var(--glow-card);
  }
  h1 { margin: 0; font-size: clamp(2.3rem, 6vw, 3.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1; }
  .intro { margin: 16px 0 18px; color: var(--muted); max-width: 60ch; font-size: 1.06rem; line-height: 1.65; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 22px; font: 400 0.9rem var(--mono); }
  .links a:not(.btn) { text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
  .links a:not(.btn):hover { color: var(--t-project); border-color: var(--t-project); }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .portrait { max-width: 240px; justify-self: center; }
  }
</style>
