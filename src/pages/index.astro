---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Featured from '../components/Featured.astro';
import EntryIndex from '../components/EntryIndex.astro';
import Slideshow from '../components/Slideshow.astro';
import Contact from '../components/Contact.astro';
import { featured, publishedEntries } from '../lib/entries';
import { getGalleryItems } from '../lib/gallery-data';

const entries = publishedEntries(await getCollection('posts'));
const latest = featured(entries);
const gallery = await getGalleryItems();
---
<Base>
  <Hero />
  {latest && <Featured entry={latest} />}
  <EntryIndex entries={entries} limit={8} filters="buttons" />
  <Slideshow items={gallery} />
  <Contact />
</Base>
